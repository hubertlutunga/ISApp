# Copier ce fichier vers scripts/backup/rclone-crypt.env puis adapter les valeurs.

# Remote cloud de base deja configure dans rclone (non chiffre)
# Exemple Backblaze B2: b2:isapp-backups
# Exemple S3: s3:isapp-backups
ISAPP_RCLONE_BASE_REMOTE_PATH="b2:my-bucket/isapp-backups"

# Nom du remote chiffre a creer
ISAPP_RCLONE_CRYPT_REMOTE_NAME="isapp_crypt"

# Mots de passe de chiffrement rclone crypt (obligatoires)
ISAPP_RCLONE_CRYPT_PASSWORD="CHANGE_ME_LONG_SECRET"
ISAPP_RCLONE_CRYPT_PASSWORD2="CHANGE_ME_SECOND_SECRET"

# Sous-dossier cible dans le remote chiffre
ISAPP_RCLONE_CRYPT_SUBPATH="mysql"

# Chemin final utilise par offsite_push.sh
ISAPP_RCLONE_REMOTE_PATH="isapp_crypt:mysql"
