APP_URL=https://invitationspeciale.com/usalumni
APP_ENV=production
APP_TIMEZONE=Africa/Kinshasa

# SMTP US Alumni (prioritaire)
USALUMNI_SMTP_HOST=invitationspeciale.com
USALUMNI_SMTP_PORT=587
USALUMNI_SMTP_USER=usalumni@invitationspeciale.com
USALUMNI_SMTP_PASSWORD=
USALUMNI_SMTP_ENCRYPTION=tls
# Valeurs acceptées: tls, ssl, none
USALUMNI_SMTP_FROM_NAME=Section des Affaires publiques
USALUMNI_SMTP_REPLY_TO=

# Fallback to DRCALUMNI_* puis ISAPP SMTP when USALUMNI_* is empty.
